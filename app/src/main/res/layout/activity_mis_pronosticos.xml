<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MisPronosticosActivity">

    <!-- =========================
         ENCABEZADO
         ========================= -->

    <ImageView
        android:id="@+id/label_fondo"
        android:layout_width="0dp"
        android:layout_height="225dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/usuario" />

    <ImageView
        android:id="@+id/label_ondas"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ondas" />

    <ImageView
        android:id="@+id/icn_usuario"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_persona"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/label_bienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bienvenido/a,"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/icn_usuario"
        app:layout_constraintTop_toTopOf="@+id/icn_usuario" />

    <TextView
        android:id="@+id/tvNombreUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="TextView"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/label_bienvenido"
        app:layout_constraintTop_toBottomOf="@+id/label_bienvenido" />

    <TextView
        android:id="@+id/label_participante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Participante"
        android:textColor="#4CAF50"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/icn_usuario"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreUsuario" />


    <!-- =========================
         TÍTULO
         ========================= -->

    <LinearLayout
        android:id="@+id/contenedorTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:translationY="-15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:translationX="-5dp"
                android:translationY="4dp"
                android:src="@drawable/ic_portapapeles"
                app:tint="#082B5B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Mis pronósticos"
                android:textColor="#082B5B"
                android:textSize="21sp"
                android:textStyle="bold"
                android:translationX="-9dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:text="Todo lo que has pronosticado en el torneo"
            android:textColor="#082B5B"
            android:textSize="13sp"
            android:translationY="-2dp" />

    </LinearLayout>


    <!-- =========================
         LISTA DE PRONÓSTICOS
         ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMisPronosticos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="90dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedorTitulo"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contenedorMisPronosticos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp" />

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>


    <!-- =========================
         VOLVER
         ========================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="135dp"
        android:layout_height="48dp"
        android:layout_marginBottom="50dp"
        android:text="←   Volver"
        android:textAllCaps="false"
        android:textColor="#082B5B"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#082B5B"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
